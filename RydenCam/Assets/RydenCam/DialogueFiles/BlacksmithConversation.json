{"inkVersion":21,"root":[[{"->":"blacksmith_intro"},["done",{"#f":5,"#n":"g-0"}],null],"done",{"blacksmith_intro":[["^Blacksmith: You're not from around here. ","#","^id:intro ","/#","#","^shot:portrait","/#","\n","^Blacksmith: The northern road has been quiet lately. ","#","^id:road","/#","\n","ev","str","^Just passing through.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^None of your business.","/str","/ev",{"*":".^.c-1","flg":20},{"c-0":["\n","^Player: I'm heading north. ","#","^id:north ","/#","#","^shot:over_shoulder ","/#","#","^target:Blacksmith","/#","\n",{"->":"friendly"},{"#f":5}],"c-1":["\n","^Player: That's none of your concern!!. ","#","^id:refusal","/#","\n","^Player: Rawer.ss","\n",{"->":"hostile"},{"#f":5}]}],{"#f":1}],"friendly":[["^Blacksmith: Fair enough. You'll need a sound blade. ","#","^id:offer","/#","\n","^Player: What happened to the road? ","#","^id:question","/#","\n","^Troll: The bridge is gone. Take the old mill path. ","#","^id:warning","/#","\n","ev","str","^Thank the blacksmith.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Ask about supplies.","/str","/ev",{"*":".^.c-1","flg":20},{"c-0":["\n","^Player: Thank you. I'll remember that. ","#","^id:thanks","/#","\n",{"->":"farewell"},{"#f":5}],"c-1":["\n","^Player: Can I buy here? ","#","^id:supplies","/#","\n","^Blacksmith: My sister runs the store next door. ","#","^id:store","/#","\n",{"->":"farewell"},{"#f":5}]}],{"#f":1}],"hostile":["^Blacksmith: Watch your attitude. ","#","^id:attitude","/#","\n","^Player: Sorry. It's been a long journey. ","#","^id:apology","/#","\n",{"->":"farewell"},{"#f":1}],"farewell":["^Blacksmith: Safe travels, stranger. ","#","^id:farewell ","/#","#","^shot:frame_share ","/#","#","^target:Player","/#","\n","end",{"#f":1}],"#f":1}],"listDefs":{}}